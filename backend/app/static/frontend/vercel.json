{
  "version": 2,
  "name": "pothipura-youth-committee",
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    {
      "src": "/janmashtami",
      "dest": "/janmashtami.html"
    },
    {
      "src": "/sports",
      "dest": "/sports.html"
    },
    {
      "src": "/transparency",
      "dest": "/transparency.html"
    },
    {
      "src": "/donors",
      "dest": "/donors.html"
    },
    {
      "src": "/donate",
      "dest": "/donate.html"
    },
    {
      "src": "/committee",
      "dest": "/committee.html"
    },
    {
      "src": "/schedule",
      "dest": "/schedule.html"
    },
    {
      "src": "/admin-login",
      "dest": "/admin-login.html"
    },
    {
      "src": "/admin",
      "dest": "/admin-login.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
